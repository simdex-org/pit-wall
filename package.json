{
  "name": "pit-wall",
  "version": "1.0.6",
  "private": true,
  "license": "MIT",
  "author": "Simdex-org, Simplezes, William19D",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @pitwall/web build && pnpm --filter @pitwall/bridge build",
    "simulation": "pnpm app",
    "app": "pnpm --filter @pitwall/launcher prepare:resources && pnpm --filter @pitwall/launcher tauri dev",
    "app:build": "pnpm --filter @pitwall/launcher package",
    "app:portable": "pnpm --filter @pitwall/launcher package:portable",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "shots": "node scripts/shots.mjs",
    "smoke": "tsx scripts/smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "^1.65.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.30.1"
}
